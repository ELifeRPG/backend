<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Only the host references Mediator.SourceGenerator — see ARCHITECTURE.md §9e. -->
    <PackageReference Include="Mediator.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\World.Domain\World.Domain.csproj" />
    <!--
      Application->Application exception (ARCHITECTURE.md §9e): only for the batched
      ItemCatalogEntriesQuery contract — the grant path resolves a granted item's PrefabClassName
      through it, and the snapshot write path reads its ItemPersistence to decide whether a
      world-parented instance gets a ground TTL. Both values are fields of that contract's own
      published result shape (ItemCatalogEntry), so the Items.Domain types this pulls in transitively
      are the contract's, never a reach into Items' internals; World.Domain still depends on nothing.
    -->
    <ProjectReference Include="..\..\Items\Items.Application\Items.Application.csproj" />
    <!-- Only for Accounts.Application's public GameServerIdByClientIdQuery contract, used by
         RegistryCurrentGameServer — never Accounts.Domain/Infrastructure. See ARCHITECTURE.md §9e. -->
    <ProjectReference Include="..\..\Accounts\Accounts.Application\Accounts.Application.csproj" />
    <!-- Only for Characters.Application's public CharactersOnServerQuery contract — the ack path's
         server guard. Never Characters.Domain/Infrastructure. See ARCHITECTURE.md §9e. -->
    <ProjectReference Include="..\..\Characters\Characters.Application\Characters.Application.csproj" />
    <!-- For IItemInstanceRepositoryFactory's CrossModuleSessionHandle parameter — see ARCHITECTURE.md §9e. -->
    <ProjectReference Include="..\..\Shared\Shared.Integration.Abstractions\Shared.Integration.Abstractions.csproj" />
  </ItemGroup>

</Project>
