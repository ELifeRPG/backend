<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- This test project is its own composition root, so it needs Mediator.SourceGenerator itself. See ARCHITECTURE.md §9e. -->
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\World\World.Application\World.Application.csproj" />
    <ProjectReference Include="..\..\src\World\World.Infrastructure\World.Infrastructure.csproj" />
    <!-- Review round 3's endpoint test seam. World.Api's own AssemblyInfo.cs grants this assembly
         InternalsVisibleTo so the two pure functions behind POST /api/inventory/snapshots — the request
         parse and the result-to-IResult mapping — can be asserted on directly. Neither touches HTTP, DI
         or the database; the only thing that had stopped them being tested was `private static`. The
         FrameworkReference is what gives this project IResult/ProblemHttpResult to assert against; no
         host is started. -->
    <ProjectReference Include="..\..\src\World\World.Api\World.Api.csproj" />
    <!-- Needed to seed a catalog entry for the grant path (GrantAsync resolves PrefabClassName through it). -->
    <ProjectReference Include="..\..\src\Items\Items.Application\Items.Application.csproj" />
    <ProjectReference Include="..\..\src\Items\Items.Infrastructure\Items.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Characters\Characters.Application\Characters.Application.csproj" />
    <ProjectReference Include="..\..\src\Characters\Characters.Infrastructure\Characters.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Accounts\Accounts.Application\Accounts.Application.csproj" />
    <ProjectReference Include="..\..\src\Accounts\Accounts.Infrastructure\Accounts.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Shared\Shared.Integration\Shared.Integration.csproj" />
  </ItemGroup>

</Project>
